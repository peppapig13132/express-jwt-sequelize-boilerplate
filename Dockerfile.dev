# syntax=docker/dockerfile:1

# Full image includes build tools for bcrypt — no apt-get step (avoids flaky Debian mirror downloads).
FROM node:20-bookworm

WORKDIR /app

COPY package.json package-lock.json ./
# Use npm install until package-lock.json is regenerated locally with: npm install
RUN npm install

COPY . .

EXPOSE 8000

CMD ["npm", "run", "start:dev"]
