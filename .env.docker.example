# Copy to .env.docker and adjust values for Docker Compose.
# Used by: docker compose --env-file .env.docker ...

APP_PORT=8000
SECRETKEY=change-me-to-a-random-string-at-least-32-characters-long
DB_PORT=5432
DB_NAME=express_boilerplate
DB_ADMIN=postgres
DB_PASSWORD=postgres
DB_SYNC=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_DAYS=7
